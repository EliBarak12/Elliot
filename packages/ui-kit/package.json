{
  "name": "@elliot/ui-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Elliot's MCP Apps template kit — shadcn-styled presets built as single-file HTML views served at ui:// URIs. Dependencies are exact-pinned so the committed assets in elliot_core/apps/assets rebuild byte-identically.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build-all.mjs",
    "check": "node scripts/build-all.mjs --check"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.30.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "autoprefixer": "10.5.4",
    "postcss": "8.5.26",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vite": "8.2.1",
    "vite-plugin-singlefile": "2.3.3"
  }
}
