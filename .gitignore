# Python
__pycache__/
*.pyc
*.pyo
*.pyd
.venv/
.venv*/
dist/
build/
*.egg-info/
.eggs/

# Test / coverage
.coverage
.coverage.*
htmlcov/
.pytest_cache/

# Type checkers
.mypy_cache/
.ruff_cache/

# Node
node_modules/
.pnpm-store/

# Vite / build output
packages/studio/dist/
packages/studio/.vite/

# Elliot runtime data — never commit secrets or live data
.elliot/
.env
.env.local
.env.*.local

# Connector files contain user secrets — opt-in via connectors/
*.connector.json
!templates/**/*.connector.json
# The bundled demo connector is secret-free by design and must ship
# (guarded by packages/core/tests/test_demo_connector.py).
!connectors/my-saas.connector.json

# Logs
*.ndjson

# macOS
.DS_Store

# JetBrains
.idea/

# VS Code (keep .vscode/launch.json and settings.json if present)
.vscode/extensions.json

.elliot/secrets.enc

# E2E run artifacts (screenshots, captured logs)
dev/e2e/artifacts/

# Per-user auth demo runtime artifacts
dev/examples/**/.vault.db
dev/examples/**/.vault_oauth.db
