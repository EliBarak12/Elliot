{
  "name": "@elliot/ui-kit",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Elliot's MCP Apps template kit — shadcn-styled presets built as single-file HTML views served at ui:// URIs. Dependencies are exact-pinned so the committed assets in elliot_core/apps/assets rebuild byte-identically.",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build-all.mjs",
    "check": "node scripts/build-all.mjs --check"
  },
  "dependencies": {
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "1.29.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/react": "19.1.4",
    "@types/react-dom": "19.1.5",
    "@vitejs/plugin-react": "4.5.2",
    "autoprefixer": "10.4.21",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.19",
    "typescript": "5.8.3",
    "vite": "6.4.2",
    "vite-plugin-singlefile": "2.3.3"
  }
}
