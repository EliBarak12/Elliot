          "description": "Filter by item name"
        }
      ],
      "filter_groups": [
        {
          "logic": "AND",
          "conditions": [
            {
              "field": "name",
              "operator": "contains",
              "parameter_name": "name"
            }
          ]
        }
      ],
      "return_fields": [],
      "order_by": [],
      "limit": 100,
      "offset_parameter": null
    }
  ],
  "skills": []
