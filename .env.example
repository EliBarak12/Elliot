# ── Auth ────────────────────────────────────────────────────────────────────
# Leave blank for local dev (no auth). Set for any server deployment.
# The plugin and runtime check X-Elliot-Key against this value (constant-time).
# Generate with: openssl rand -hex 32
ELLIOT_API_KEY=

# VITE_API_KEY is a *build-time* variable baked into the Studio bundle. It is
# NOT a per-user secret — anyone who can load Studio in their browser can read
# it. Treat it as a deployment-scoped token used to authenticate Studio's
# browser-side requests to the plugin/runtime. Set to the same value as
# ELLIOT_API_KEY in production. Leave blank for local dev.
VITE_API_KEY=

# Origin allowed to call the plugin and runtime via CORS. Defaults to the
# Studio dev server. Override for any non-dev deployment.
ELLIOT_STUDIO_ORIGIN=http://localhost:5173

# ── Connectors ──────────────────────────────────────────────────────────────
ELLIOT_CONNECTORS_DIR=./connectors
# Single-connector mode (takes priority over ELLIOT_CONNECTORS_DIR):
ELLIOT_CONNECTOR=./connectors/my-api.connector.json

# ── Observation DB ──────────────────────────────────────────────────────────
# Default: local SQLite. For MySQL: mysql+pymysql://user:pass@host/elliot
ELLIOT_DB_URL=sqlite:///.elliot/observations.db
# REQUIRED for the `mysql` compose profile. Generate with:
#   openssl rand -hex 24
MYSQL_ROOT_PASSWORD=

# ── Sessions / Audit ────────────────────────────────────────────────────────
ELLIOT_SESSIONS_LOG=.elliot/sessions.ndjson
ELLIOT_AUDIT_LOG=.elliot/audit.ndjson

# ── Rate Limiting ────────────────────────────────────────────────────────────
ELLIOT_RATE_LIMIT=120/minute

# ── Request body cap (per-request, all routes) ───────────────────────────────
# Default 4 MiB. Rejects oversized POST bodies before they're materialised.
ELLIOT_MAX_REQUEST_BODY_BYTES=4194304

# ── Logging ─────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Workspace secrets at rest ───────────────────────────────────────────────
# Required when ELLIOT_ENV != "development". The passphrase is run through
# HKDF-SHA256 to derive the AES-GCM key that encrypts .elliot/secrets.enc.
# Generate with:  openssl rand -hex 32
ELLIOT_SECRET_KEY=

# Set to "production" / "staging" to enforce a real ELLIOT_SECRET_KEY. Leave
# blank or set to "development" / "dev" / "test" to use the dev passphrase
# with a runtime warning. Set ELLIOT_ALLOW_DEV_SECRET_KEY=1 to bypass the
# refusal explicitly (for one-off CI tasks).
ELLIOT_ENV=

# ── Studio ──────────────────────────────────────────────────────────────────
VITE_PLUGIN_URL=http://localhost:3000
VITE_RUNTIME_URL=http://localhost:3001

# ── Service URLs (for elliot status CLI) ────────────────────────────────────
ELLIOT_PLUGIN_URL=http://localhost:3000
ELLIOT_RUNTIME_URL=http://localhost:3001
ELLIOT_STUDIO_URL=http://localhost:5173
