    "format": "prettier --write ."
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "eslint": "^10.8.1",
    "prettier": "^3.9.6",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "hono@<4.12.25": ">=4.12.25",
      "fast-uri@<3.1.5": ">=3.1.5",
      "ip-address@<10.3.1": ">=10.3.1"
    }
  }
